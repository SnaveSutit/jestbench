{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"verbatimModuleSyntax": false,
		"allowImportingTsExtensions": false,
		"isolatedModules": true,
		"module": "commonjs",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["examples", "tests", "node_modules", "**/*.test.ts"]
}
