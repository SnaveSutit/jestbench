{
	"name": "@snavesutit/jestbench",
	"version": "0.2.1",
	"description": "A Jest addon for writing end-to-end tests for Blockbench plugins - runs your plugin inside a real, isolated Blockbench instance and lets tests drive its API and GUI.",
	"keywords": [
		"blockbench",
		"jest",
		"testing",
		"plugin",
		"e2e",
		"electron"
	],
	"license": "MIT",
	"author": "Titus Evans (SnaveSutit) <snavesutit@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/SnaveSutit/jestbench"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./environment": "./dist/environment.js",
		"./matchers": "./dist/matchers.js",
		"./jest-preset": "./jest-preset.js",
		"./jest-preset.js": "./jest-preset.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"jest-preset.js",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p examples/hello-plugin/tsconfig.json --noEmit",
		"test": "bun test",
		"test:e2e": "bun run build && jest",
		"lint": "eslint . --max-warnings=0 --no-warn-ignored",
		"format": "prettier --write .",
		"check-formatting": "prettier . --check",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"envbench": "^4.1.0",
		"jest-environment-node": ">=29 <31",
		"jiti": "^2.7.0",
		"puppeteer-core": "^23.11.1"
	},
	"peerDependencies": {
		"jest": ">=29 <31"
	},
	"devDependencies": {
		"@jest/environment": "^30.5.1",
		"@jest/globals": "^30.5.1",
		"@jest/types": "^30.5.1",
		"@swc/core": "^1.16.1",
		"@swc/jest": "^0.2.39",
		"@types/bun": "latest",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.4.0",
		"eslint": "^9.37.0",
		"globals": "^16.4.0",
		"jest": "^30.5.1",
		"prettier": "^3.6.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.45.0"
	},
	"engines": {
		"node": ">=20"
	},
	"trustedDependencies": [
		"@swc/core"
	]
}
